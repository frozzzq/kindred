OLLAMA_HOST=http://<ip-de-la-pc>:11434
OLLAMA_MODEL=qwen3:8b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# edge-tts (gratis, primera opcion): voces de Microsoft Edge, sin API key.
# Sin nada configurado cae a es-MX-JorgeNeural para cualquier motor; para
# voces distintas por agente, configura _OLLAMA/_GEMINI (ej. una mujer para
# Crimson y un hombre para Clover). Lista las disponibles con:
# edge-tts --list-voices
EDGE_TTS_VOICE=
EDGE_TTS_VOICE_OLLAMA=es-MX-DaliaNeural
EDGE_TTS_VOICE_GEMINI=es-MX-JorgeNeural

# ElevenLabs (respaldo de pago, si edge-tts falla)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_OLLAMA=
ELEVENLABS_VOICE_ID_GEMINI=

OBSIDIAN_VAULT_PATH=/ruta/a/la/boveda

GEMINI_DAILY_QUOTA=1000

# Amplificacion digital del microfono (1.0 = sin cambios). Util si tu mic
# entrega poca señal incluso al volumen maximo de Windows.
GANANCIA_MICROFONO=3.0

# Carpetas donde el agente puede trabajar (abrir, y desde la Fase 10 crear/mover
# archivos), separadas por ";". Vacio = Escritorio, Documentos, Descargas e Imagenes.
CARPETAS_PERMITIDAS=

# Fase 7: nucleo (recordatorios, briefing). HH:MM, 24 horas.
# HORA_BRIEFING/HORA_CIERRE vacias = no se disparan. HORARIO_SILENCIO vacio = nunca hay silencio
# (puede cruzar medianoche, ej. 23:00-07:00: en ese rango no se avisa nada, se retrasa a que termine).
HORA_BRIEFING=08:00
HORA_CIERRE=21:30
HORARIO_SILENCIO=23:00-07:00
